# Home Control Hub — omgevingsvariabelen (voor ontwikkeling; GEEN echte waarden).
# De standaard TrueNAS Custom App heeft GEEN verplichte variabelen. Geheimen staan nooit hier: die maakt de app zelf
# in <HCH_DATA_DIR>/secrets (vault.key, identity.ed25519).

# --- Koppeling met de Hub (contract §3) ---
# Adres van de Hub. Op de NAS: het LAN-adres van de NAS + poort van de Hub (uit de wizard, nooit aannemen).
HUB_URL=
# Eenmalig koppeltoken uit de Hub (vervalt na 60 min of na eerste gebruik). Leeg = koppelen via koppelcode.
HUB_ENROLLMENT_TOKEN=
# Adres waarop de Hub deze dienst bereikt (optioneel).
HCH_PUBLIC_URL=

# --- Dienst ---
# Datamap (in de image: /appdata).
HCH_DATA_DIR=./.appdata
# SQLAlchemy-URL. In de image: postgresql+psycopg://hch@/hch?host=/tmp/hch-pg (unix-socket, geen wachtwoord).
# Lokaal: een eigen database met prefix hch_ op de ontwikkel-PostgreSQL.
HCH_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/hch_dev
# Poort van API + statuspagina.
HCH_PORT=30420
# Map met Alembic-migraties (alleen nodig buiten de broncode; de image zet dit zelf).
HCH_ALEMBIC_DIR=

# --- Beveiliging / afstelling ---
# JWKS-cache van de Hub: verse periode en maximale extra 'oude' periode vóór fail-closed (seconden).
HCH_JWKS_TTL_S=300
HCH_JWKS_MAX_STALE_S=900
# B13-001: maximale leeftijd van de laatste handmatige oefening (dagen).
HCH_BREAK_GLASS_MAX_AGE_DAYS=90
# Interval van de worker (seconden).
HCH_WORKER_INTERVAL_S=10
# ALLEEN ontwikkeling/tests: Hub op 127.0.0.1 toestaan (in de container wijst loopback naar zichzelf).
HCH_ALLOW_LOOPBACK_HUB=
# Vertrouwde reverse proxies (CIDR-lijst, komma-gescheiden). Standaard leeg.
HCH_TRUSTED_PROXIES=

# --- Tests ---
# PostgreSQL voor integratietests (standaard de lokale ontwikkel-PostgreSQL, database hch_test_api).
HCH_TEST_DATABASE_URL=
